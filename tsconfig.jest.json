{
  "compilerOptions": {
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "allowJs": true,
    "paths": {
      "@api/*": ["api/*"],
      "@app-types/*": ["app-types/*"],
      "@assets/*": ["assets/*"],
      "@components/*": ["components/*"],
      "@config/*": ["config/*"],
      "@hooks/*": ["hooks/*"],
      "@pages/*": ["pages/*"],
      "@store/*": ["store/*"],
      "@styles/*": ["styles/*"],
      "@utils/*": ["utils/*"],
      "@schemas/*": ["schemas/*"]
    },
    "types": ["jest"]
  },
  "include": ["src", "**/*.test.ts", "**/*.test.tsx"]
}
